{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "site/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/site/index.html"
    },
    {
      "src": "/site/index.html",
      "dest": "/site/index.html"
    },
    {
      "src": "/faqs",
      "dest": "/site/faqs.html"
    },
    {
      "src": "/site/faqs.html",
      "dest": "/site/faqs.html"
    }
  ]
}
